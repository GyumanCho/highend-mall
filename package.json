{
  "name": "highend-fashion-mall",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "type-check": "turbo run type-check",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "db:seed": "pnpm --filter @repo/db db:seed",
    "db:studio": "pnpm --filter @repo/db db:studio",
    "web:dev": "pnpm --filter @repo/web dev",
    "mobile:start": "pnpm --filter @repo/mobile start"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.9.2",
    "prettier": "^3.8.1"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
